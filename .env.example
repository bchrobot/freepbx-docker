# Copy to .env and adjust. Secrets go in the *.txt files (see README), not here.

# Public name of the web UI (Let's Encrypt via Caddy); localhost uses Caddy's local CA
DOMAIN=localhost

# RTP port range forwarded by run.sh and configured in Asterisk by freepbx-init
RTP_START=16384
RTP_END=32767

# Compose network; change only if it collides with another network on the host
PBX_SUBNET=172.18.0.0/16
PBX_GATEWAY=172.18.0.1
PBX_IP=172.18.0.20

# Outbound mail (voicemail-to-email, FreePBX notifications)
SMTP_RELAYHOST=[smtp.gmail.com]:587
SMTP_RELAY_USER=you@gmail.com
SMTP_FROM=you@gmail.com
MAIL_HOSTNAME=freepbx.localdomain

# FreePBX
FREEPBX_NOTIFICATION_EMAIL=
# Upgrade all modules on every start (security updates are always applied by cron)
FREEPBX_AUTO_UPGRADE=false
